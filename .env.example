JWT_SECRET=REPLACE_WITH_STRONG_32B_PLUS_SECRET
JWT_ACCESS_TOKEN_VALIDITY_MS=300000
JWT_REFRESH_TOKEN_VALIDITY_MS=86400000

SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_AUTH0_CLIENT_ID=TU_AUTH0_CLIENT_ID
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_AUTH0_CLIENT_SECRET=TU_AUTH0_CLIENT_SECRET
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_AUTH0_SCOPE=openid,profile,email
SPRING_SECURITY_OAUTH2_CLIENT_PROVIDER_AUTH0_ISSUER_URI=https://TU_TENANT.us.auth0.com/

# --- RabbitMQ ---
# Used by identity-service and notification-service.
RABBITMQ_USER=healthcore
RABBITMQ_PASS=CHANGE_ME

# --- Resend (notification-service) ---
RESEND_API_KEY=REPLACE_WITH_RESEND_KEY
RESEND_FROM_EMAIL=no-reply@healthcore.example
RESEND_FROM_NAME=HealthCore

# --- Identity gRPC ---
GRPC_IDENTITY_PORT=9090
GRPC_IDENTITY_TARGET=identity-service:9090

# --- Agenda service ---
# Host port where agenda-service will be exposed (container always listens on 8080).
AGENDA_SERVICE_PORT=8083
# Logical service name used in logs and metadata.
AGENDA_SERVICE_NAME=AGENDA-SVC

# --- Clinical service ---
# Host port where clinical-service will be exposed (container always listens on 8083).
SERVER_PORT_CLINICAL=8087
APP_OPENAPI_TITLE=HealthCore Clinical Service API
APP_OPENAPI_VERSION=1.0.0
APP_OPENAPI_DESCRIPTION=Clinical records, professional linking, observations and nutrition plans
APP_OPENAPI_SERVER_URL=http://localhost:8087

# --- Agenda MongoDB ---
# Host port for agenda MongoDB (container always listens on 27017).
AGENDA_MONGO_PORT=27019
# Database name used by agenda-service.
AGENDA_MONGO_DB=healthcore_agenda

# --- Agenda Mongo Express UI ---
# Host port for the Agenda Mongo Express UI (open http://localhost:<PORT>).
AGENDA_MONGO_EXPRESS_PORT=8084
# Keep false in local if you want quick access; set true and add auth vars if needed.
AGENDA_MONGO_EXPRESS_BASICAUTH=false

# --- Agenda dependencies ---
# clinical-service gRPC target used by agenda-service.
GRPC_CLIENT_CLINICAL_ADDRESS=static://clinical-service:50051
# true in local for easier testing; set false in stricter environments.
AGENDA_CLINICAL_ALLOW_ALL=true

# --- SonarQube (Static Analysis) ---
SONAR_DB_USER=sonar
SONAR_DB_PASSWORD=CHANGE_ME_SECRET
SONAR_DB_NAME=sonarqube

FRONTEND_URL=http://localhost:5173

# --- Grafana ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
