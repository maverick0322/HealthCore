{
  "name": "health-core-desktop",
  "private": true,
  "version": "1.0.0",
  "description": "HealthCore Desktop Application (Electron wrapper)",
  "repository": {
    "type": "git",
    "url": "https://github.com/maverick0322/HealthCore.git"
  },
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "node build-renderer.js && electron-vite build && node copy-renderer.js",
    "preview": "electron-vite preview",
    "build:win": "npm run build && electron-builder --win --dir",
    "dist:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux",
    "dist": "npm run build && electron-builder --publish always"
  },
  "build": {
    "appId": "com.healthcore.desktop",
    "productName": "HealthCore",
    "icon": "build/icons/icon.png",
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "maverick0322",
        "repo": "HealthCore"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icons/icon.ico"
    },
    "nsis": {
      "installerIcon": "build/icons/icon.ico",
      "uninstallerIcon": "build/icons/icon.ico",
      "installerHeaderIcon": "build/icons/icon.ico",
      "shortcutName": "HealthCore"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icons/icon.png"
    }
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.1.0",
    "vite": "^6.3.4"
  }
}
